<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>אתגר ההצלחה היומי</title>
    <style>
        :root {
            --primary: #6366f1;
            --secondary: #a855f7;
            --bg: #0f172a;
            --card-bg: #1e293b;
            --text: #f8fafc;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at center, #1e1b4b, #0f172a);
            color: var(--text);
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            text-align: center;
            padding: 20px;
            max-width: 500px;
            width: 90%;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(to right, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p.subtitle {
            color: #94a3b8;
            margin-bottom: 30px;
        }

        /* מכולת הקלף */
        .challenge-card {
            background: var(--card-bg);
            border: 2px solid #334155;
            border-radius: 20px;
            padding: 40px 20px;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            overflow: hidden;
        }

        .challenge-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

        #challenge-text {
            font-size: 1.5rem;
            font-weight: bold;
            line-height: 1.4;
        }

        /* אנימציית ערבוב */
        .shaking {
            animation: shake 0.5s infinite;
            filter: blur(2px);
            opacity: 0.7;
        }

        @keyframes shake {
            0% { transform: translate(1px, 1px) rotate(0deg); }
            10% { transform: translate(-1px, -2px) rotate(-1deg); }
            30% { transform: translate(3px, 2px) rotate(0deg); }
            50% { transform: translate(-1px, 2px) rotate(1deg); }
            70% { transform: translate(3px, 1px) rotate(-1deg); }
            100% { transform: translate(1px, -2px) rotate(0deg); }
        }

        /* כפתור */
        .btn-draw {
            margin-top: 30px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-draw:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 25px rgba(99, 102, 241, 0.4);
        }

        .btn-draw:disabled {
            background: #475569;
            cursor: not-allowed;
        }

        /* קריאה לפעולה בתחתית */
        .cta-box {
            margin-top: 60px;
            padding: 20px;
            border-top: 1px solid #334155;
            font-size: 0.9rem;
        }

        .cta-link {
            color: #818cf8;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            margin-top: 10px;
            padding: 8px 16px;
            border: 1px solid #818cf8;
            border-radius: 5px;
            transition: all 0.3s;
        }

        .cta-link:hover {
            background: #818cf8;
            color: white;
        }

        /* אפקט הניצוצות */
        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            background-color: var(--primary);
            border-radius: 50%;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>הצעד הבא שלך</h1>
        <p class="subtitle">הגרל משימה יומית שתקדם אותך לגרסה הטובה ביותר של עצמך.</p>

        <div class="challenge-card" id="card">
            <div id="challenge-text">מוכן להתחיל?</div>
        </div>

        <button class="btn-draw" onclick="drawChallenge()" id="drawBtn">הגרל משימה עכשיו</button>

        <div class="cta-box">
            <p>רוצה לקחת את זה לשלב הבא?</p>
            <p>נהל את המשימות וההרגלים שלך באפליקציה המלאה שלנו</p>
            <a href="https://pcs365.co.il/index.html" class="cta-link">לחץ כאן למעבר לאפליקציה</a>
        </div>
    </div>

    <script>
        // בנק המשימות - כאן המפתח יכול להוסיף משימות בקלות
        const challenges = [
            "קרא/י 10 דפים בספר התפתחות אישית",
            "בצע/י אימון ספורט של 30 דקות",
            "כתוב/י 3 דברים שאת/ה מודה עליהם היום",
            "הקדש/י 10 דקות למדיטציה או נשימות",
            "צפה/י בהרצאת TED מעוררת השראה",
            "סדר/י את סביבת העבודה שלך למיקוד מקסימלי",
            "שתה/י 2 ליטר מים במהלך היום",
            "תכנן/י את 3 המשימות הכי חשובות למחר",
            "התנתק/י מהרשתות החברתיות לשעתיים רצופות",
            "פרגן/י לאדם קרוב במילה טובה או הודעה"
        ];

        function drawChallenge() {
            const card = document.getElementById('card');
            const text = document.getElementById('challenge-text');
            const btn = document.getElementById('drawBtn');
            
            // השבתת הכפתור והפעלת אנימציה
            btn.disabled = true;
            card.classList.add('shaking');
            text.innerText = "מחשב מסלול להצלחה...";

            // הדמיה של "הגרלה"
            setTimeout(() => {
                const randomIndex = Math.floor(Math.random() * challenges.length);
                card.classList.remove('shaking');
                text.innerText = challenges[randomIndex];
                btn.disabled = false;
                btn.innerText = "הגרל משימה אחרת";
                
                // אפקט ויזואלי של צבע משתנה
                card.style.borderColor = "#a855f7";
                setTimeout(() => card.style.borderColor = "#334155", 1000);
            }, 1200);
        }
    </script>
</body>
</html>
